# Build contexts are an explicit allowlist; credentials, user uploads, test
# fixtures, archives, repository history and local build products stay out.
*
!package.json
!package-lock.json
!tsconfig.json
!apps/
!apps/api/
!apps/api/src/
!apps/api/src/**
!apps/web/
!apps/web/app/
!apps/web/app/**
!apps/web/components/
!apps/web/components/**
!apps/web/public/
!apps/web/public/**
!apps/web/next.config.mjs
!apps/web/next-env.d.ts
!apps/web/proxy.ts
!apps/web/tsconfig.json
apps/web/.next
apps/web/node_modules
apps/web/.env*
apps/web/**/*.tsbuildinfo
!database/
!database/migrations/
!database/migrations/**
!scripts/
!scripts/bootstrap-database.mjs
!scripts/migrate.mjs
!scripts/build-web.mjs
!scripts/start-web.mjs
!infra/
!infra/*.Dockerfile
**/.env
**/.env.*
**/node_modules
**/.next
**/*.tsbuildinfo
