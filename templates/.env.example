# Template only. Never commit real values. Codex must confirm keys required by pinned SDKs.
APP_MODE=development
# Public browser origin; same origin is required for cookies and mutations.
APP_ORIGIN=http://localhost:3000
# Server-only web rewrite destination (set when building Next).
API_ORIGIN=http://127.0.0.1:3100
# Public storage origin for browser CSP; exact APP_ORIGIN must be allowed by bucket CORS.
S3_BROWSER_ORIGIN=http://localhost:9000
AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_DATABASE_URL=postgresql://desvio_auth:CHANGE_ME@localhost:5432/desvio
APP_DATABASE_URL=postgresql://desvio_app:CHANGE_ME@localhost:5432/desvio
MAIL_DATABASE_URL=postgresql://desvio_mail:CHANGE_ME@localhost:5432/desvio
WORKER_DATABASE_URL=postgresql://desvio_worker:CHANGE_ME@localhost:5432/desvio
DISPATCHER_DATABASE_URL=postgresql://desvio_dispatcher:CHANGE_ME@localhost:5432/desvio
MAIL_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=accounts@desvio.example
CLAMD_HOST=localhost
CLAMD_PORT=3310
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=desvio
TEMPORAL_TASK_QUEUE=desvio-assets
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=marketing-os-private
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
APP_ENCRYPTION_KEY=GENERATE_WITH_SECRETS_MANAGER
OPENAI_API_KEY=
# Actual Higgsfield SDK auth env names must be verified against selected version
HIGGSFIELD_API_KEY=
POSTIZ_BASE_URL=http://localhost:5000
POSTIZ_API_KEY=
LIVE_SMOKE_ENABLED=false
LIVE_SPEND_CAP_USD=0
ALLOWLIST_TEST_TENANT_IDS=
ALLOWLIST_TEST_SOCIAL_ACCOUNT_IDS=
MOCK_PROVIDERS_ENABLED=true
# Production bootstrap must reject mock providers for enabled capabilities.

# Worker only. Enables Gemini text planning when an operator-scoped Gemini grant exists.
GEMINI_API_KEY=
