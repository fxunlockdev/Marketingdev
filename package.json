{
  "name": "desvio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant Marketing OS; implementation in progress",
  "scripts": {
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/main.js",
    "test:foundation": "node scripts/foundation-test.mjs",
    "start:worker": "node dist/worker-main.js",
    "build:web": "next build apps/web --webpack",
    "dev:web": "next dev apps/web --webpack -H 127.0.0.1 -p 3000",
    "start:web": "next start apps/web -H 127.0.0.1 -p 3000",
    "test:browser": "node scripts/foundation-test.mjs --web",
    "start:provisioner": "node dist/provisioner-main.js",
    "setup:dev": "node infra/worker-control/setup-wizard.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/s3-request-presigner": "3.1154.0",
    "@google/genai": "2.30.0",
    "@higgsfield/client": "0.2.6",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "better-auth": "1.7.12",
    "express": "5.3.0",
    "fabric": "7.4.0",
    "jose": "6.2.13",
    "kysely": "0.29.7",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "openai": "7.39.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
