{
  "scope": "Implemented bootstrap, API and standalone-web inputs only. Worker, provisioner and provider setup require their existing audited contracts; complete deployment automation is pending.",
  "bootstrap": {
    "required": ["APP_MODE", "DESVIO_BOOTSTRAP_CONFIRM", "DESVIO_DATABASE_NAME", "MIGRATION_DATABASE_URL", "APP_DATABASE_PASSWORD", "AUTH_DATABASE_PASSWORD", "MAIL_DATABASE_PASSWORD", "WORKER_DATABASE_PASSWORD", "DISPATCHER_DATABASE_PASSWORD", "POSTIZ_PROVISIONER_DATABASE_PASSWORD"],
    "confirmation": "initialize-isolated-desvio-database",
    "password_format": "Six distinct, randomly generated 32-byte lowercase hex strings"
  },
  "database_roles": {
    "desvio_app": {"password": "APP_DATABASE_PASSWORD", "url": "APP_DATABASE_URL", "service": "api"},
    "desvio_auth": {"password": "AUTH_DATABASE_PASSWORD", "url": "AUTH_DATABASE_URL", "service": "api"},
    "desvio_mail": {"password": "MAIL_DATABASE_PASSWORD", "url": "MAIL_DATABASE_URL", "service": "api"},
    "desvio_worker": {"password": "WORKER_DATABASE_PASSWORD", "url": "WORKER_DATABASE_URL", "service": "worker"},
    "desvio_dispatcher": {"password": "DISPATCHER_DATABASE_PASSWORD", "url": "DISPATCHER_DATABASE_URL", "service": "worker"},
    "desvio_provisioner": {"password": "POSTIZ_PROVISIONER_DATABASE_PASSWORD", "url": "POSTIZ_PROVISIONER_DATABASE_URL", "service": "provisioner"}
  },
  "api": {
    "required": ["APP_MODE", "APP_ORIGIN", "AUTH_SECRET", "AUTH_DATABASE_URL", "APP_DATABASE_URL", "MAIL_DATABASE_URL", "MAIL_ENCRYPTION_KEY", "SMTP_HOST", "SMTP_PORT", "SMTP_USER", "SMTP_PASSWORD", "SMTP_FROM", "S3_ENDPOINT", "S3_REGION", "S3_BUCKET", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY"],
    "optional": ["PORT", "LISTEN_HOST", "SMTP_SECURE", "RENDER_RUNTIME_IMAGE", "POSTIZ_ENABLED", "POSTIZ_PROVISIONING_ENABLED", "POSTIZ_PUBLISHING_ENABLED", "POSTIZ_OAUTH_ENABLED", "OAUTH_ENCRYPTION_KEY"],
    "secret_boundary": "No migration administrator, provisioner signing secret or paid model key on this service"
  },
  "web": {
    "build_required": ["API_ORIGIN"],
    "runtime_required": ["APP_MODE", "APP_ORIGIN", "API_ORIGIN", "S3_BROWSER_ORIGIN"],
    "runtime_optional": ["PORT", "LISTEN_HOST"],
    "secret_boundary": "No database, SMTP, provider, OAuth or Postiz credentials on this service"
  }
}
